generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model filme {
    id        Int      @id @default(autoincrement())
    titulo      String
    descricao   String?
    duracao       Int
    genero     String
    nota       Decimal @db.Decimal(3,1)
    available Boolean @default(true)
    createdAt DateTime @default(now())

    @@map("filme")
}
